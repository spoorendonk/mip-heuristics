# Style contract for the clang-format gate (see cmake/Lint.cmake).
#
# Owned by this repository.  It began as a shared house style carried in a
# tooling submodule and symlinked in; the symlink is gone and nothing
# regenerates this file, deliberately: a gate whose style contract can change
# from outside the repository turns red for reasons that have nothing to do
# with the code under review.  The sibling `.clang-tidy` diverges from that
# shared set in five places anyway, so the pair is owned together.
---
Language: Cpp
BasedOnStyle: Google
Standard: Latest
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
NamespaceIndentation: None
PointerAlignment: Left
SortIncludes: CaseInsensitive
IncludeBlocks: Regroup
IncludeCategories:
  # Two groups, not three: the regexes below split on quote-vs-angle, and
  # nothing finer.  Written out because the obvious reading of the pair is
  # wrong in both halves.
  #
  # Quote-includes.  This project's own headers *and* HiGHS's, which are
  # quote-included too (`"mip/HighsMipSolver.h"`, `"lp_data/HighsLp.h"`), so
  # the two interleave alphabetically in one block rather than separating.
  - Regex: '".*"'
    Priority: 1
  # Angle-includes beginning with a lowercase letter.  That is the whole
  # standard library, not just third-party paths such as `<catch2/...>`, so
  # this group holds both and sorts them together.
  - Regex: '<[a-z].*>'
    Priority: 2
  # Angle-includes beginning with anything else.  Nothing under `src/` or
  # `tests/` matches today, and nothing is expected to: HiGHS's capitalized
  # headers are reached through quotes.  Kept as an explicit catch-all so
  # such an include lands here by rule instead of at clang-format's implicit
  # last-priority default.
  - Regex: '<.*>'
    Priority: 3
